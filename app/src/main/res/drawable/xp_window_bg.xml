<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层深蓝边框 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#0024b0" />
            <solid android:color="#ECE9D8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- 内层浅蓝边框 -->
    <item android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#316AC5" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
