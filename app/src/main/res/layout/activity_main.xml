<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bliss" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#CC1E5AA8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="打开侧滑栏"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/topAvatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/white"
                    android:contentDescription="头像"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="w Email"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/desktop"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/desktopInboxBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/desktopInboxIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="收件箱"
                            android:src="@drawable/folder_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:shadowColor="#80000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:text="收件箱"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="56dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/desktopSendBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/desktopSendIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="发件箱"
                            android:src="@drawable/folder_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:shadowColor="#80000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:text="发件箱"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowInbox"
                    android:layout_width="300dp"
                    android:layout_height="400dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/titleBarInbox"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📥 收件箱 - w Email"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseInbox"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="暂无邮件"
                                android:textColor="#333333"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowSent"
                    android:layout_width="300dp"
                    android:layout_height="400dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/titleBarSent"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📤 已发送 - w Email"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseSent"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="暂无已发送邮件"
                                android:textColor="#333333"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowDraft"
                    android:layout_width="300dp"
                    android:layout_height="400dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="60dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/titleBarDraft"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📝 草稿箱 - w Email"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseDraft"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="没有草稿"
                                android:textColor="#333333"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowTrash"
                    android:layout_width="300dp"
                    android:layout_height="400dp"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="80dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/titleBarTrash"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🗑️ 垃圾邮件 - w Email"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseTrash"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="垃圾箱空空如也"
                                android:textColor="#333333"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowCompose"
                    android:layout_width="300dp"
                    android:layout_height="420dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="70dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/titleBarCompose"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✉️ 写邮件"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseCompose"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <EditText android:id="@+id/etTo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="收件人" android:inputType="textEmailAddress" />
                            <EditText android:id="@+id/etSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="主题" />
                            <EditText android:id="@+id/etBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="正文" android:gravity="top|start" android:minLines="5" android:inputType="textMultiLine" />
                            <Button android:id="@+id/btnSend" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:text="发送" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/windowSettings"
                    android:layout_width="300dp"
                    android:layout_height="460dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/xp_window_bg"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/titleBarSettings"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/xp_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚙️ 服务器设置"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseSettings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/xp_close_btn"
                            android:contentDescription="关闭" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <CheckBox android:id="@+id/cbSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="启用 XP 音效提醒" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><EditText android:id="@+id/etMailPrefix" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="邮箱名称" android:inputType="text" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@" android:gravity="center" android:padding="4dp"/><EditText android:id="@+id/etMailDomain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="邮箱域名" android:inputType="text" /></LinearLayout>
                            <EditText android:id="@+id/etPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="密码" android:inputType="textPassword" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="发送 SMTP" android:textColor="#1E5AA8" android:layout_marginTop="8dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <EditText android:id="@+id/etSmtpHost" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:hint="主机" />
                                <EditText android:id="@+id/etSmtpPort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="端口" android:inputType="number" />
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收件 IMAP" android:textColor="#1E5AA8" android:layout_marginTop="8dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <EditText android:id="@+id/etImapHost" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:hint="主机" />
                                <EditText android:id="@+id/etImapPort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="端口" android:inputType="number" />
                            </LinearLayout>
                            <Button android:id="@+id/btnSavePass" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="16dp" android:text="保存全部配置" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/statusBar"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="#DD1A1A1A"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="准备就绪 · 正在建设"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E5AA8"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/drawerAvatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@android:color/white"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="w Email"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawerAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未设置账号"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/navCompose" android:layout_width="match_parent" android:layout_height="52dp" android:background="#E8F0FE" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="20dp" android:text="✉️   写邮件" android:textColor="#1E5AA8" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:text="常用文件夹" android:textColor="#999999" android:textSize="11sp" />
        <TextView android:id="@+id/navInbox" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="📥   收件箱" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/navSent" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="📤   已发送" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/navDraft" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="📝   草稿箱" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/navTrash" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="🗑️   垃圾邮件" android:textColor="#222222" android:textSize="15sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:text="我的邮箱" android:textColor="#999999" android:textSize="11sp" />
        <TextView android:id="@+id/navMyMail" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="📮   未设置域名" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/navSettings" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="⚙️   服务器设置" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/navAbout" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="20dp" android:clickable="true" android:focusable="true" android:text="ℹ️   声明 / 关于" android:textColor="#222222" android:textSize="15sp" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="WEmail · GPLv3\nisaquxet08-ai/WEmail" android:textColor="#999999" android:textSize="11sp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
